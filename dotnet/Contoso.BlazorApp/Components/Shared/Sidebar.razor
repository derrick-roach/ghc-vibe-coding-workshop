@inject NavigationManager Nav

<aside class="flex flex-col items-center gap-6 py-6 px-3 bg-amber-500 h-full min-h-screen w-14">
    <button @onclick="GoHome" aria-label="Home"
        class="@NavButtonClass("/")">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" />
        </svg>
    </button>

    <button @onclick="GoSearch" aria-label="Search"
        class="@NavButtonClass("/search")">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16a6.471 6.471 0 0 0 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
        </svg>
    </button>

    <button aria-label="Profile"
        class="p-2 rounded-full text-amber-900 hover:text-white transition-colors mt-auto">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z" />
        </svg>
    </button>

    <button @onclick="GoHome" aria-label="Close"
        class="p-2 rounded-full text-amber-900 hover:text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
        </svg>
    </button>
</aside>

@code {
    private bool IsActive(string path)
    {
        var uri = new Uri(Nav.Uri);
        return uri.AbsolutePath == path;
    }

    private string NavButtonClass(string path) => IsActive(path)
        ? "p-2 rounded-full transition-colors text-white"
        : "p-2 rounded-full transition-colors text-amber-900 hover:text-white";

    private void GoHome() => Nav.NavigateTo("/");
    private void GoSearch() => Nav.NavigateTo("/search");
}
