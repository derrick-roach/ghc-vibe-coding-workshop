@inject NavigationManager Nav
@inject ApiService Api
@inject AppState AppState

<div role="button" tabindex="0" aria-label="@($"Post by {Post.Username}")"
    @onclick="HandleCardClick"
    @onkeydown="HandleCardKeyDown"
    class="bg-amber-500 border-b border-amber-600 p-3 cursor-pointer hover:bg-amber-400 transition-colors">

    <div class="flex items-center gap-2 mb-1">
        <div class="w-8 h-8 rounded-full bg-gray-300 flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-500" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z" />
            </svg>
        </div>
        <span class="font-semibold text-white text-sm">@Post.Username</span>
    </div>

    <p class="text-white text-sm mb-2 pl-10">@Post.Content</p>

    <div class="flex items-center gap-4 pl-10">
        <button @onclick="HandleLike" @onclick:stopPropagation="true"
            @onkeydown="HandleLikeKeyDown" @onkeydown:stopPropagation="true"
            aria-label="@($"Like post, {Post.LikesCount} likes")" tabindex="0"
            class="flex items-center gap-1 text-white hover:text-red-300 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
            </svg>
            <span class="text-xs">@Post.LikesCount</span>
        </button>

        <button @onclick="GoToPost" @onclick:stopPropagation="true"
            @onkeydown="GoToPostKeyDown" @onkeydown:stopPropagation="true"
            aria-label="@($"Comments, {Post.CommentsCount} comments")" tabindex="0"
            class="flex items-center gap-1 text-white hover:text-blue-200 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z" />
            </svg>
            <span class="text-xs">@Post.CommentsCount</span>
        </button>
    </div>
</div>

@code {
    [Parameter] public Post Post { get; set; } = default!;
    [Parameter] public EventCallback<(string PostId, bool Liked)> OnLikeToggle { get; set; }

    private async Task HandleLike()
    {
        if (string.IsNullOrEmpty(AppState.Username)) return;
        try
        {
            await Api.LikePostAsync(Post.Id, AppState.Username);
            await OnLikeToggle.InvokeAsync((Post.Id, true));
        }
        catch
        {
            try
            {
                await Api.UnlikePostAsync(Post.Id);
                await OnLikeToggle.InvokeAsync((Post.Id, false));
            }
            catch { }
        }
    }

    private async Task HandleLikeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleLike();
    }

    private void HandleCardClick() => Nav.NavigateTo($"/posts/{Post.Id}");

    private void HandleCardKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") HandleCardClick();
    }

    private void GoToPost() => Nav.NavigateTo($"/posts/{Post.Id}");

    private void GoToPostKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") GoToPost();
    }
}
