<div role="dialog" aria-modal="true" aria-label="Enter your username"
    class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-40 z-50">
    <div class="bg-white rounded-lg p-6 w-72 shadow-lg">
        <h2 class="text-center text-gray-800 font-semibold mb-4">Enter your username</h2>
        <input type="text" @bind="_value" @bind:event="oninput"
            @onkeydown="HandleKeyDown"
            placeholder="UserName"
            aria-label="Username"
            maxlength="50"
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm mb-4 focus:outline-none focus:ring-2 focus:ring-blue-400" />
        <button @onclick="HandleSubmit" tabindex="0" aria-label="Confirm username"
            disabled="@string.IsNullOrWhiteSpace(_value)"
            class="w-full bg-blue-500 hover:bg-blue-600 disabled:opacity-50 text-white text-sm py-2 rounded transition-colors">
            OK
        </button>
    </div>
</div>

@code {
    [Parameter] public EventCallback<string> OnSubmit { get; set; }

    private string _value = string.Empty;

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_value)) return;
        await OnSubmit.InvokeAsync(_value.Trim());
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleSubmit();
    }
}
